     "transcript": [
      {
       "start": 0.0,
       "end": 5.0,
       "text": "婚礼要排座位：三张桌子，三十位客人。",
       "sceneId": "h-seat"
      },
      {
       "start": 5.0,
       "end": 8.6,
       "text": "谁和谁坐一桌？",
       "sceneId": "h-seat"
      },
      {
       "start": 10.75,
       "end": 16.35,
       "text": "熟人坐一桌，生人分开坐：你已经在做聚类。",
       "sceneId": "h-seat2"
      },
      {
       "start": 17.41,
       "end": 24.01,
       "text": "聚类：把联系紧的放进一组，组和组之间联系少。",
       "sceneId": "h-what"
      },
      {
       "start": 24.01,
       "end": 29.41,
       "text": "不必知道每个人是谁，只看谁和谁有联系。",
       "sceneId": "h-what"
      },
      {
       "start": 37.0,
       "end": 42.022,
       "text": "芯片里，几百万个单元由导线连成一张网。",
       "sceneId": "h-chip"
      },
      {
       "start": 42.022,
       "end": 46.689,
       "text": "同一组的单元放在一起，导线就短；",
       "sceneId": "h-chip"
      },
      {
       "start": 46.689,
       "end": 51.089,
       "text": "跨组的导线又长又慢，还更费电。",
       "sceneId": "h-chip"
      },
      {
       "start": 51.18,
       "end": 55.98,
       "text": "课程里的五个朋友：线越粗，交情越深。",
       "sceneId": "h-friends"
      },
      {
       "start": 55.98,
       "end": 60.38,
       "text": "分成两组，切断的交情就叫 cut。",
       "sceneId": "h-friends"
      },
      {
       "start": 63.15,
       "end": 68.839,
       "text": "ABC | DE 只切断 3；AE | BCD 切断 12。",
       "sceneId": "h-count"
      },
      {
       "start": 68.839,
       "end": 74.083,
       "text": "五个人分两组：15 种分法，可以一个个试。",
       "sceneId": "h-count"
      },
      {
       "start": 74.083,
       "end": 78.683,
       "text": "一百个人呢？分法的个数有 30 位。",
       "sceneId": "h-count"
      },
      {
       "start": 80.16,
       "end": 85.16,
       "text": "一个个试，永远试不完。所以要靠算法。",
       "sceneId": "h-algos"
      },
      {
       "start": 85.16,
       "end": 90.16,
       "text": "这门课的八章，是八种回答。",
       "sceneId": "h-algos"
      },
      {
       "start": 90.16,
       "end": 95.16,
       "text": "它们大致分成几类。",
       "sceneId": "h-algos"
      },
      {
       "start": 102.5,
       "end": 110.189,
       "text": "第一类：给每一对打分，把最亲近的一对对合并（M02–M04）。",
       "sceneId": "h-families"
      },
      {
       "start": 110.189,
       "end": 117.878,
       "text": "第二类：让分组自己长出来，标签传播、谱方法（M05–M06）。",
       "sceneId": "h-families"
      },
      {
       "start": 119.27,
       "end": 126.67,
       "text": "第三类：改进已有分组，成对交换或逐个搬（M07–M08）。",
       "sceneId": "h-improve"
      },
      {
       "start": 126.67,
       "end": 133.248,
       "text": "最后一章把目标换成速度：让最慢的路径最快（M09）。",
       "sceneId": "h-improve"
      },
      {
       "start": 134.16,
       "end": 139.56,
       "text": "八章，同一个问题。",
       "sceneId": "h-route"
      },
      {
       "start": 141.5,
       "end": 147.5,
       "text": "聚类不是一个算法，而是一个问题：",
       "sceneId": "h-outro"
      },
      {
       "start": 147.5,
       "end": 154.5,
       "text": "怎样分组，才让联系留在组内？",
       "sceneId": "h-outro"
      },
      {
       "start": 154.5,
       "end": 160.5,
       "text": "每一章，给出一种回答。",
       "sceneId": "h-outro"
      },
      {
       "start": 160.5,
       "end": 167.5,
       "text": "从给一对单元打分开始。",
       "sceneId": "h-outro"
      },
      {
       "start": 170.6,
       "end": 176.6,
       "text": "从 Module 02 开始。",
       "sceneId": "h-end"
      }
     ],
