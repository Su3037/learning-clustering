     "transcript": [
      {
       "start": 0.0,
       "end": 4.6,
       "text": "在金属板上撒一层细沙，",
       "sceneId": "p-plate"
      },
      {
       "start": 4.6,
       "end": 9.2,
       "text": "用琴弓拉它的边。",
       "sceneId": "p-plate"
      },
      {
       "start": 10.75,
       "end": 16.35,
       "text": "沙聚成一条线：振动自己把板分成两半。",
       "sceneId": "p-plate2"
      },
      {
       "start": 17.41,
       "end": 21.766,
       "text": "长凳上的五个朋友，用橡皮筋连着。",
       "sceneId": "p-rule"
      },
      {
       "start": 21.766,
       "end": 26.566,
       "text": "总拉力：粗细乘以距离的平方，加起来。",
       "sceneId": "p-rule"
      },
      {
       "start": 26.566,
       "end": 31.166,
       "text": "不许挤在一点，散开后让拉力最小。",
       "sceneId": "p-rule"
      },
      {
       "start": 37.0,
       "end": 41.2,
       "text": "放手，让橡皮筋把大家拉到位。",
       "sceneId": "p-settle"
      },
      {
       "start": 41.2,
       "end": 44.4,
       "text": "交情深的被拉到一起。",
       "sceneId": "p-settle"
      },
      {
       "start": 44.4,
       "end": 50.978,
       "text": "Eva、Dev 在左，Ben、Ada 在右，Cai 居中。",
       "sceneId": "p-settle"
      },
      {
       "start": 51.18,
       "end": 54.18,
       "text": "读出每个人的位置。",
       "sceneId": "p-numbers"
      },
      {
       "start": 54.18,
       "end": 58.313,
       "text": "这串数就是 Fiedler 向量。",
       "sceneId": "p-numbers"
      },
      {
       "start": 58.313,
       "end": 61.713,
       "text": "交情深的人，数靠得近。",
       "sceneId": "p-numbers"
      },
      {
       "start": 63.15,
       "end": 67.506,
       "text": "现在，沿着长凳，每个缝隙试一刀。",
       "sceneId": "p-scissors"
      },
      {
       "start": 67.506,
       "end": 71.417,
       "text": "拆散的交情：6、3、5、6。",
       "sceneId": "p-scissors"
      },
      {
       "start": 71.417,
       "end": 75.994,
       "text": "两边各两三个人：选 3，不是正中间。",
       "sceneId": "p-scissors"
      },
      {
       "start": 80.16,
       "end": 83.56,
       "text": "把每个数都乘以负一——",
       "sceneId": "p-mirror"
      },
      {
       "start": 83.56,
       "end": 86.56,
       "text": "整排镜像翻过去。",
       "sceneId": "p-mirror"
      },
      {
       "start": 89.0,
       "end": 93.133,
       "text": "还是同一刀，只是左右换了名字。",
       "sceneId": "p-same"
      },
      {
       "start": 93.133,
       "end": 96.133,
       "text": "翻号不是新答案。",
       "sceneId": "p-same"
      },
      {
       "start": 102.5,
       "end": 106.411,
       "text": "如果是两群彼此不认识的人呢？",
       "sceneId": "p-apart"
      },
      {
       "start": 106.411,
       "end": 110.211,
       "text": "同一群的人挤在同一个数上。",
       "sceneId": "p-apart"
      },
      {
       "start": 110.211,
       "end": 116.211,
       "text": "这时 λ₂ = 0：数只说明谁连着谁。先检查连通。",
       "sceneId": "p-apart"
      },
      {
       "start": 119.27,
       "end": 122.959,
       "text": "五个人分两边，有几种分法？",
       "sceneId": "p-count"
      },
      {
       "start": 122.959,
       "end": 127.759,
       "text": "每人左或右：32 种，去掉全左、全右。",
       "sceneId": "p-count"
      },
      {
       "start": 127.759,
       "end": 132.337,
       "text": "左右交换算一种：15 种，不是 16。",
       "sceneId": "p-count"
      },
      {
       "start": 134.16,
       "end": 139.56,
       "text": "芯片上，这一刀常常是划分的起点。",
       "sceneId": "p-chip"
      },
      {
       "start": 141.5,
       "end": 147.5,
       "text": "一个数，来自整张图。",
       "sceneId": "p-outro"
      },
      {
       "start": 147.5,
       "end": 153.5,
       "text": "沿着数轴，每个缝隙都试一刀。",
       "sceneId": "p-outro"
      },
      {
       "start": 153.5,
       "end": 160.5,
       "text": "得到的是好的候选，不是最优的保证。",
       "sceneId": "p-outro"
      },
      {
       "start": 160.5,
       "end": 168.5,
       "text": "切好之后，换一换两边的人呢？下一章见。",
       "sceneId": "p-outro"
      },
      {
       "start": 170.6,
       "end": 176.6,
       "text": "下面的实验里，改边权，看数轴怎么动。",
       "sceneId": "p-end"
      }
