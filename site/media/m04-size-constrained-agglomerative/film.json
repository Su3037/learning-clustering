     "transcript": [
      {
       "start": 0.0,
       "end": 4.8,
       "text": "缆车的每把吊椅，只坐两个人。",
       "sceneId": "p-lift"
      },
      {
       "start": 4.8,
       "end": 9.4,
       "text": "排队的是三个最要好的朋友。",
       "sceneId": "p-lift"
      },
      {
       "start": 12.35,
       "end": 16.75,
       "text": "再要好，也得装得下。",
       "sceneId": "p-lift2"
      },
      {
       "start": 17.41,
       "end": 22.432,
       "text": "五个朋友分车，这次每辆车只有两个座位。",
       "sceneId": "p-rule"
      },
      {
       "start": 22.432,
       "end": 27.632,
       "text": "合并前先看装不装得下：装不下的划掉。",
       "sceneId": "p-rule"
      },
      {
       "start": 27.632,
       "end": 31.543,
       "text": "在剩下的里面，选最合得来的。",
       "sceneId": "p-rule"
      },
      {
       "start": 37.0,
       "end": 41.356,
       "text": "Ada 和 Ben 先上了一辆双座车。",
       "sceneId": "p-cars"
      },
      {
       "start": 41.356,
       "end": 47.933,
       "text": "加上 Cai 就是三人，装不下；Dev、Eva 上第二辆。",
       "sceneId": "p-cars"
      },
      {
       "start": 47.933,
       "end": 50.956,
       "text": "Cai 只能单独一辆。",
       "sceneId": "p-cars"
      },
      {
       "start": 51.18,
       "end": 54.869,
       "text": "是规则太笨吗？数一数座位。",
       "sceneId": "p-bound"
      },
      {
       "start": 54.869,
       "end": 58.469,
       "text": "五个人，每辆两个座位。",
       "sceneId": "p-bound"
      },
      {
       "start": 58.469,
       "end": 65.869,
       "text": "五除以二，向上取整：至少三辆。两辆，谁来都做不到。",
       "sceneId": "p-bound"
      },
      {
       "start": 68.2,
       "end": 73.0,
       "text": "三座出租车：两人各带大提琴，占两座。",
       "sceneId": "p-cello"
      },
      {
       "start": 73.0,
       "end": 75.933,
       "text": "两个好朋友先同车。",
       "sceneId": "p-cello"
      },
      {
       "start": 75.933,
       "end": 79.178,
       "text": "再加谁都超座：三辆车。",
       "sceneId": "p-cello"
      },
      {
       "start": 80.16,
       "end": 85.404,
       "text": "可是，Ada 配 Cai，Ben 配 Dev——",
       "sceneId": "p-flip"
      },
      {
       "start": 85.404,
       "end": 88.404,
       "text": "两辆车，刚好坐满。",
       "sceneId": "p-flip"
      },
      {
       "start": 89.0,
       "end": 92.6,
       "text": "停下了，不等于没有答案。",
       "sceneId": "p-stuck"
      },
      {
       "start": 92.6,
       "end": 96.867,
       "text": "贪心拿走最大的交情，从不回头。",
       "sceneId": "p-stuck"
      },
      {
       "start": 102.5,
       "end": 107.522,
       "text": "第二天骑双人车，Ada、Ben 先一辆。",
       "sceneId": "p-bikes"
      },
      {
       "start": 107.522,
       "end": 112.767,
       "text": "Cai、Dev 一辆：拆散两份 9，共 18。",
       "sceneId": "p-bikes"
      },
      {
       "start": 112.767,
       "end": 116.767,
       "text": "交换搭档：只拆散 11。",
       "sceneId": "p-bikes"
      },
      {
       "start": 119.27,
       "end": 122.292,
       "text": "三个故事，三种结局。",
       "sceneId": "p-three"
      },
      {
       "start": 122.292,
       "end": 125.892,
       "text": "装不下：谁来都做不到。",
       "sceneId": "p-three"
      },
      {
       "start": 125.892,
       "end": 130.026,
       "text": "走错了路：有答案，贪心没找到。",
       "sceneId": "p-three"
      },
      {
       "start": 130.026,
       "end": 133.937,
       "text": "不是最好：合法，但还能更好。",
       "sceneId": "p-three"
      },
      {
       "start": 134.16,
       "end": 140.56,
       "text": "芯片上，每块区域能放的面积有限，聚类也要装得下。",
       "sceneId": "p-chip"
      },
      {
       "start": 141.5,
       "end": 147.5,
       "text": "合法，不等于完成。",
       "sceneId": "p-outro"
      },
      {
       "start": 147.5,
       "end": 153.5,
       "text": "完成，不等于最好。",
       "sceneId": "p-outro"
      },
      {
       "start": 153.5,
       "end": 160.5,
       "text": "停下的时候，说清楚是哪一种。",
       "sceneId": "p-outro"
      },
      {
       "start": 160.5,
       "end": 168.5,
       "text": "如果节点不合并，只是改“标签”呢？下一章见。",
       "sceneId": "p-outro"
      },
      {
       "start": 170.6,
       "end": 176.6,
       "text": "下面的实验里，改容量、改大小，看诊断怎么说。",
       "sceneId": "p-end"
      }
