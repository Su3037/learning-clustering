     "transcript": [
      {
       "start": 0.0,
       "end": 4.6,
       "text": "雨落在窗上。",
       "sceneId": "p-drops"
      },
      {
       "start": 4.6,
       "end": 9.2,
       "text": "挨得最近的两滴，先连成一滴。",
       "sceneId": "p-drops"
      },
      {
       "start": 10.75,
       "end": 16.35,
       "text": "然后再找最近的一对。合并，从不拆开。",
       "sceneId": "p-drops2"
      },
      {
       "start": 17.41,
       "end": 21.81,
       "text": "五个朋友分两辆车，也可以这样分。",
       "sceneId": "p-rule"
      },
      {
       "start": 21.81,
       "end": 26.832,
       "text": "一开始每人自成一组：拆散的交情共 18。",
       "sceneId": "p-rule"
      },
      {
       "start": 26.832,
       "end": 31.632,
       "text": "每次合并最投机的两组，直到只剩两组。",
       "sceneId": "p-rule"
      },
      {
       "start": 37.0,
       "end": 44.022,
       "text": "最投机的有两对：Ada–Ben 和 Dev–Eva，都是 5。",
       "sceneId": "p-step1"
      },
      {
       "start": 44.022,
       "end": 50.022,
       "text": "平票就按名字：A 在 D 前，Ada 和 Ben 先上车。",
       "sceneId": "p-step1"
      },
      {
       "start": 51.18,
       "end": 58.424,
       "text": "Ada 和 Ben 成了一组。Cai 的两根线合起来：1 + 4 = 5。",
       "sceneId": "p-step2"
      },
      {
       "start": 58.424,
       "end": 64.113,
       "text": "又和 Dev–Eva 平票；按名字，Cai 加入。",
       "sceneId": "p-step2"
      },
      {
       "start": 66.08,
       "end": 71.102,
       "text": "最后 Dev 和 Eva 一车。只剩两组，停。",
       "sceneId": "p-step3"
      },
      {
       "start": 73.0,
       "end": 76.244,
       "text": "你见过这样的文件夹吗？",
       "sceneId": "p-files"
      },
      {
       "start": 76.244,
       "end": 78.822,
       "text": "10 排在 2 前面。",
       "sceneId": "p-files"
      },
      {
       "start": 80.16,
       "end": 84.738,
       "text": "按数值，2 在前；按文字，10 在前。",
       "sceneId": "p-flip"
      },
      {
       "start": 84.738,
       "end": 88.649,
       "text": "文字是一个字符一个字符地比。",
       "sceneId": "p-flip"
      },
      {
       "start": 89.0,
       "end": 94.067,
       "text": "原网页比较候选，也是当成文字来比。",
       "sceneId": "p-bug"
      },
      {
       "start": 94.067,
       "end": 100.2,
       "text": "“-1” 排在 “-5” 前：亲和度 1 成了最好的一对。",
       "sceneId": "p-bug"
      },
      {
       "start": 100.2,
       "end": 103.889,
       "text": "被切断的交情从 3 变成了 9。",
       "sceneId": "p-bug"
      },
      {
       "start": 104.0,
       "end": 108.4,
       "text": "修正：逐个字段比，数字按数值比。",
       "sceneId": "p-fix"
      },
      {
       "start": 108.4,
       "end": 114.978,
       "text": "本课程还专门测了 10 对 2、2.5 对 2，防止碰巧正确。",
       "sceneId": "p-fix"
      },
      {
       "start": 117.14,
       "end": 121.14,
       "text": "到了酒店，每间房只有两张床。",
       "sceneId": "p-rooms"
      },
      {
       "start": 121.14,
       "end": 125.496,
       "text": "Cai 想加入哪一间，都是三个人。",
       "sceneId": "p-rooms"
      },
      {
       "start": 127.6,
       "end": 133.0,
       "text": "所以停在三间：不硬塞，也不谎称凑够了。",
       "sceneId": "p-stop"
      },
      {
       "start": 134.16,
       "end": 140.76,
       "text": "芯片设计里，同样的合并把成千上万个单元先粗化成几簇。",
       "sceneId": "p-chip"
      },
      {
       "start": 141.5,
       "end": 147.5,
       "text": "这一路，每一步都只看眼前。",
       "sceneId": "p-outro"
      },
      {
       "start": 147.5,
       "end": 154.5,
       "text": "选最好的一对，合并，不再回头。",
       "sceneId": "p-outro"
      },
      {
       "start": 154.5,
       "end": 160.5,
       "text": "这一次，结果恰好最好。",
       "sceneId": "p-outro"
      },
      {
       "start": 160.5,
       "end": 168.5,
       "text": "如果早早选错一步呢？下一章见。",
       "sceneId": "p-outro"
      },
      {
       "start": 170.6,
       "end": 176.6,
       "text": "下面的实验里，改 K、改容量，看轨迹怎么变。",
       "sceneId": "p-end"
      }
