      },
      {
       "start": 55.536,
       "end": 58.602,
       "text": "起点是 1，往后加。",
       "sceneId": "p-time"
      },
      {
       "start": 58.602,
       "end": 62.136,
       "text": "g 和前面的都在一间：3。",
       "sceneId": "p-time"
      },
      {
       "start": 63.15,
       "end": 67.283,
       "text": "i 前面七道工序，只剩三个位置。",
