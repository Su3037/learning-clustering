   "transcript": [
    {
     "start": 3.0,
     "end": 9.356,
     "text": "一条链：P → X → Y → O，每个节点延迟 1，跨簇加 3。",
     "sceneId": "a01-goal"
    },
    {
     "start": 9.356,
     "end": 15.489,
     "text": "分成 {P,X} 和 {Y,O}：跨一次边界，延迟 7。",
     "sceneId": "a01-goal"
    },
    {
     "start": 15.489,
     "end": 20.067,
     "text": "换一种分法，跨两次边界：延迟 10。",
     "sceneId": "a01-goal"
    },
    {
     "start": 20.067,
     "end": 24.2,
     "text": "延迟只看最长路径跨了几次边界。",
     "sceneId": "a01-goal"
    },
    {
     "start": 24.6,
     "end": 32.289,
     "text": "Rajaraman 与 Wong 的模型：组合电路是一张有向无环图。",
     "sceneId": "a02-model"
    },
    {
     "start": 32.289,
     "end": 35.089,
     "text": "每个节点有延迟 δ。",
     "sceneId": "a02-model"
    },
    {
     "start": 35.089,
     "end": 39.889,
     "text": "簇内连线不加延迟，跨簇连线固定加 D。",
     "sceneId": "a02-model"
    },
    {
     "start": 39.889,
     "end": 42.911,
     "text": "每个簇有容量上限 M。",
     "sceneId": "a02-model"
    },
    {
     "start": 42.911,
     "end": 47.044,
     "text": "还有关键的一条：允许复制节点。",
     "sceneId": "a02-model"
    },
    {
     "start": 47.444,
     "end": 52.911,
     "text": "为什么要复制？g 同时供给两个簇里的 i 和 j。",
     "sceneId": "a03-replica"
    },
    {
     "start": 52.911,
     "end": 58.6,
     "text": "g 只能放在一边：另一边要跨簇取信号，多付 D。",
     "sceneId": "a03-replica"
    },
    {
     "start": 58.6,
     "end": 62.956,
     "text": "复制一份 g：两边都在簇内拿到它。",
     "sceneId": "a03-replica"
    },
    {
     "start": 62.956,
     "end": 67.978,
     "text": "代价是面积：多一个实例，多占一份面积。",
     "sceneId": "a03-replica"
    },
    {
     "start": 68.378,
     "end": 74.956,
     "text": "原作的 12 节点算例，由影片画面复原——这是候选数据。",
     "sceneId": "a04-dag"
    },
    {
     "start": 74.956,
     "end": 79.311,
     "text": "容量 4，D = 3，每个节点延迟 1。",
     "sceneId": "a04-dag"
    },
    {
     "start": 79.311,
     "end": 85.667,
     "text": "Δ(x, v)：从 x 到 v 的最长节点延迟，计 v 不计 x。",
     "sceneId": "a04-dag"
    },
    {
     "start": 85.667,
     "end": 90.689,
     "text": "例如 b 到 k 经过 e、g、i、k：Δ = 4。",
     "sceneId": "a04-dag"
    },
    {
     "start": 91.089,
     "end": 97.0,
     "text": "按拓扑序逐个打标签。d 的祖先 a、b 都能放进簇。",
     "sceneId": "a05-early"
    },
    {
     "start": 97.0,
     "end": 100.467,
     "text": "e、f 同理：标签都是 2。",
     "sceneId": "a05-early"
    },
    {
     "start": 100.467,
     "end": 103.489,
     "text": "f：只有一个祖先 a。",
     "sceneId": "a05-early"
    },
    {
     "start": 103.489,
     "end": 108.956,
     "text": "g 的祖先 b、c、e 都在簇内：l(g) = 3。",
     "sceneId": "a05-early"
    },
    {
     "start": 108.956,
     "end": 111.089,
     "text": "h：l = 2。",
     "sceneId": "a05-early"
    },
    {
     "start": 111.489,
     "end": 115.622,
     "text": "i 有 7 个祖先，容量只够放 3 个。",
     "sceneId": "a06-label-i"
    },
    {
     "start": 115.622,
     "end": 120.867,
     "text": "每个祖先的得分：l(x) + Δ(x, i)。",
     "sceneId": "a06-label-i"
    },
    {
     "start": 120.867,
     "end": 129.0,
     "text": "取得分最高的 g、e、c；得分相同时，拓扑序靠后的优先——这是假设。",
     "sceneId": "a06-label-i"
    },
    {
     "start": 129.0,
     "end": 136.244,
     "text": "簇内的 PI 是 c：l1 = 4。簇外最大是 b：l2 = 4 + 3 = 7。",
     "sceneId": "a06-label-i"
    },
    {
     "start": 136.244,
     "end": 142.156,
     "text": "l(i) = 7：在这个模型里，信号最早 7 到达 i。",
     "sceneId": "a06-label-i"
    },
    {
     "start": 142.556,
     "end": 145.8,
     "text": "j 同理：l(j) = 7。",
     "sceneId": "a07-rest"
    },
    {
     "start": 145.8,
     "end": 151.489,
     "text": "k：候选簇 {k, j, i, g}，l(k) = 8。",
     "sceneId": "a07-rest"
    },
    {
     "start": 151.489,
     "end": 157.178,
     "text": "l：候选簇 {l, j, g, e}，l(l) = 8。",
     "sceneId": "a07-rest"
    },
    {
     "start": 157.578,
     "end": 163.933,
     "text": "标记阶段的伪代码：先算 Δ，PI 的标签等于自身延迟。",
     "sceneId": "a08-code"
    },
    {
     "start": 163.933,
     "end": 167.844,
     "text": "对每个节点，按得分排序祖先。",
     "sceneId": "a08-code"
    },
    {
     "start": 167.844,
     "end": 172.422,
     "text": "把得分最高的放进候选簇，直到容量。",
     "sceneId": "a08-code"
    },
    {
     "start": 172.422,
     "end": 179.444,
     "text": "l = max(l1, l2)。下一集：从输出倒推出真正的簇。",
     "sceneId": "a08-code"
    }
   ],
