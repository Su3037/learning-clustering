      {
       "start": 0.0,
       "end": 4.6,
       "text": "一道菜要经过四个人，每人一分钟。",
       "sceneId": "p-open"
      },
      {
       "start": 4.6,
       "end": 8.6,
       "text": "一间厨房只放得下两个人。",
       "sceneId": "p-open"
      },
      {
       "start": 10.75,
       "end": 15.083,
       "text": "穿过院子去另一间：多 3 分钟。",
       "sceneId": "p-ask"
      },
      {
       "start": 15.083,
       "end": 17.217,
       "text": "这样分：7。",
       "sceneId": "p-ask"
      },
      {
       "start": 17.41,
       "end": 20.81,
       "text": "换个分法，也都放得下。",
       "sceneId": "p-rule"
      },
      {
       "start": 20.81,
       "end": 24.721,
       "text": "可是跨了两次院子：10 分钟。",
       "sceneId": "p-rule"
      },
      {
       "start": 24.721,
       "end": 29.721,
       "text": "快慢只看最长那条路跨了几次院子。",
       "sceneId": "p-rule"
      },
      {
