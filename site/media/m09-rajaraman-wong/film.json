      },
      {
       "start": 70.75,
       "end": 73.35,
       "text": "i 最早第 7 分钟。",
       "sceneId": "p-i"
      },
      {
       "start": 74.0,
       "end": 76.6,
       "text": "j 也是 7。",
       "sceneId": "p-labels"
      },
      {
       "start": 76.6,
       "end": 80.0,
       "text": "两道成品：都是 8。",
       "sceneId": "p-labels"
      },
      {
       "start": 80.0,
       "end": 83.689,
       "text": "这还只是时间，厨房还没分。",
       "sceneId": "p-labels"
      },
      {
       "start": 89.0,
       "end": 93.356,
       "text": "k 的厨房要 g 和 j，l 的厨房也要。",
       "sceneId": "p-twins"
      },
      {
       "start": 93.356,
       "end": 95.956,
       "text": "那就各做一份。",
       "sceneId": "p-twins"
      },
      {
       "start": 102.5,
       "end": 107.833,
       "text": "从成品往回推：缺什么，就再开一间厨房。",
       "sceneId": "p-back"
      },
      {
       "start": 107.833,
       "end": 112.411,
       "text": "八间厨房，二十个人，做十二道工序。",
       "sceneId": "p-back"
      },
      {
       "start": 112.411,
       "end": 116.1,
       "text": "两道成品都在第 8 分钟出来。",
       "sceneId": "p-back"
      },
      {
       "start": 119.27,
       "end": 124.737,
       "text": "不许做两份呢？试遍所有分法，最快也要 10。",
       "sceneId": "p-compare"
      },
      {
       "start": 124.737,
       "end": 128.203,
       "text": "多八个人手，快了两分钟。",
       "sceneId": "p-compare"
      },
