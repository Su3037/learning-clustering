   "transcript": [
    {
     "start": 3.0,
     "end": 8.467,
     "text": "上一集，每个节点都得到了标签和一个候选簇。",
     "sceneId": "b01-recap"
    },
    {
     "start": 8.467,
     "end": 12.822,
     "text": "真正用到哪些簇，要从输出端倒推。",
     "sceneId": "b01-recap"
    },
    {
     "start": 13.222,
     "end": 19.356,
     "text": "从输出 k 开始：选中 k 的候选簇 {k, j, i, g}。",
     "sceneId": "b02-select"
    },
    {
     "start": 19.356,
     "end": 25.933,
     "text": "再看输出 l：{l, j, g, e}。g 和 j 又出现了一次。",
     "sceneId": "b02-select"
    },
    {
     "start": 25.933,
     "end": 31.178,
     "text": "k 的簇外输入 d：它的簇是 {d, b, a}。",
     "sceneId": "b02-select"
    },
    {
     "start": 31.178,
     "end": 34.2,
     "text": "e：{e, c, b}。",
     "sceneId": "b02-select"
    },
    {
     "start": 34.2,
     "end": 36.778,
     "text": "f：{f, a}。",
     "sceneId": "b02-select"
    },
    {
     "start": 36.778,
     "end": 39.356,
     "text": "h：{h, c}。",
     "sceneId": "b02-select"
    },
    {
     "start": 39.356,
     "end": 43.267,
     "text": "b 和 c 是输入，各自单独成簇。",
     "sceneId": "b02-select"
    },
    {
     "start": 43.267,
     "end": 45.4,
     "text": "一共 8 个簇。",
     "sceneId": "b02-select"
    },
    {
     "start": 45.8,
     "end": 50.822,
     "text": "把每个簇的成员生成为实例：节点@簇根。",
     "sceneId": "b03-instances"
    },
    {
     "start": 50.822,
     "end": 56.289,
     "text": "8 个簇，20 个实例——逻辑节点只有 12 个。",
     "sceneId": "b03-instances"
    },
    {
     "start": 56.289,
     "end": 61.756,
     "text": "b 有 3 个实例：每个都是同一个逻辑门的副本。",
     "sceneId": "b03-instances"
    },
    {
     "start": 61.756,
     "end": 67.889,
     "text": "每个实例的输入都要完整：簇内取，或跨簇从簇根取。",
     "sceneId": "b03-instances"
    },
    {
     "start": 68.289,
     "end": 73.756,
     "text": "沿实例图计算到达时间：簇内 +0，跨簇 +3。",
     "sceneId": "b04-arrival"
    },
    {
     "start": 73.756,
     "end": 78.778,
     "text": "两个输出都在时间 8 到达，正好等于标签。",
     "sceneId": "b04-arrival"
    },
    {
     "start": 79.178,
     "end": 84.2,
     "text": "允许复制：最大延迟 8，用了 20 个实例。",
     "sceneId": "b05-compare"
    },
    {
     "start": 84.2,
     "end": 89.889,
     "text": "禁止复制：穷举所有合法分组，最好也只有 10。",
     "sceneId": "b05-compare"
    },
    {
     "start": 89.889,
     "end": 94.244,
     "text": "多 8 个实例，换来 2 个单位的延迟。",
     "sceneId": "b05-compare"
    },
    {
     "start": 94.244,
     "end": 98.6,
     "text": "所以最优性结论以允许复制为前提。",
     "sceneId": "b05-compare"
    },
    {
     "start": 99.0,
     "end": 105.356,
     "text": "最后说清边界。最优性来自论文，只在它的模型里成立。",
     "sceneId": "b06-scope"
    },
    {
     "start": 105.356,
     "end": 110.822,
     "text": "这张 12 节点图是候选复原，平票规则是假设。",
     "sceneId": "b06-scope"
    },
    {
     "start": 110.822,
     "end": 114.956,
     "text": "测试检查实现一致，不证明最优。",
     "sceneId": "b06-scope"
    },
    {
     "start": 114.956,
     "end": 121.311,
     "text": "这份提交与教师目录的 Lab 09 不一致，对应待确认。",
     "sceneId": "b06-scope"
    },
    {
     "start": 121.711,
     "end": 126.289,
     "text": "恢复阶段的伪代码：从所有输出开始。",
     "sceneId": "b07-code"
    },
    {
     "start": 126.289,
     "end": 131.533,
     "text": "选中簇根的候选簇，簇外输入成为新的簇根。",
     "sceneId": "b07-code"
    },
    {
     "start": 131.533,
     "end": 135.444,
     "text": "每个选中的簇生成自己的实例。",
     "sceneId": "b07-code"
    },
    {
     "start": 135.444,
     "end": 140.689,
     "text": "每个实例的输入都必须完整——这就是复制。",
     "sceneId": "b07-code"
    }
   ],
