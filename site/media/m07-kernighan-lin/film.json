      },
      {
       "start": 71.128,
       "end": 74.128,
       "text": "这只是试探。",
       "sceneId": "p-worse"
      },
      {
       "start": 80.16,
       "end": 82.96,
       "text": "回头看这一轮——",
       "sceneId": "p-back"
      },
      {
       "start": 82.96,
       "end": 86.16,
       "text": "累计 +9，然后 +1。",
