     "transcript": [
      {
       "start": 3.4,
       "end": 8.644,
       "text": "KL 不从零分组，而是改进一个已有的二分。",
       "sceneId": "k01-problem"
      },
      {
       "start": 8.644,
       "end": 13.667,
       "text": "本章的种子是 AE | BCD，cut 12。",
       "sceneId": "k01-problem"
      },
      {
       "start": 13.667,
       "end": 19.133,
       "text": "唯一的操作：左右各一个互换，两侧人数不变。",
       "sceneId": "k01-problem"
      },
      {
       "start": 19.533,
       "end": 23.533,
       "text": "每个节点先算外部与内部边权。",
       "sceneId": "k02-dvalues"
      },
      {
       "start": 23.533,
       "end": 28.333,
       "text": "D = 外部 − 内部：A 是 +6，C 是 −4。",
       "sceneId": "k02-dvalues"
      },
      {
       "start": 28.333,
       "end": 33.356,
       "text": "D 是只把这个点换过去时 cut 的下降量。",
       "sceneId": "k02-dvalues"
      },
      {
       "start": 33.756,
       "end": 38.778,
       "text": "一对交换的收益：两个 D 相加，再减 2w。",
       "sceneId": "k03-gain"
      },
      {
       "start": 38.778,
       "end": 45.8,
       "text": "E–D 被两个 D 都算成外部边，交换后它仍被切，所以减两次。",
       "sceneId": "k03-gain"
      },
      {
       "start": 45.8,
       "end": 51.489,
       "text": "六个候选里，A↔D 最大：+9；E↔D 是 −1。",
       "sceneId": "k03-gain"
      },
      {
       "start": 51.889,
       "end": 57.133,
       "text": "一轮：选最大收益对，交换，锁定，重算 D。",
       "sceneId": "k04-pass"
      },
      {
       "start": 57.133,
       "end": 61.267,
       "text": "第 1 步 A↔D，cut 12 → 3。",
       "sceneId": "k04-pass"
      },
      {
       "start": 61.267,
       "end": 67.844,
       "text": "第 2 步剩下的全是负数，照样走 E↔C：cut 升到 11。",
       "sceneId": "k04-pass"
      },
      {
       "start": 67.844,
       "end": 72.2,
       "text": "左侧没有可动的点，本轮试探结束。",
       "sceneId": "k04-pass"
      },
      {
       "start": 72.6,
       "end": 76.289,
       "text": "累计收益：0、+9、+1。",
       "sceneId": "k05-prefix"
      },
      {
       "start": 76.289,
       "end": 82.2,
       "text": "最大的是 k = 1：从起点只应用 A↔D，cut 3。",
       "sceneId": "k05-prefix"
      },
      {
       "start": 82.2,
       "end": 86.333,
       "text": "第 2 步被撤回：试探不等于接受。",
       "sceneId": "k05-prefix"
      },
      {
       "start": 86.733,
       "end": 91.089,
       "text": "第二轮从 cut 3 出发，全部解锁。",
       "sceneId": "k06-stop"
      },
      {
       "start": 91.089,
       "end": 95.667,
       "text": "累计 −8、−6，都不如什么都不做。",
       "sceneId": "k06-stop"
      },
